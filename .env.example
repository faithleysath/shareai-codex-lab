# OpenAI-compatible LLM configuration
# Copy this file to the lesson directory you want to run, then rename it to `.env`.
# Example:
#   cp /Users/laysath/proj/shareai-codex-lab/.env.example /Users/laysath/proj/shareai-codex-lab/lessons/s01-agent-loop/.env

OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_MODEL=glm-5.1